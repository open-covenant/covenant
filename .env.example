# Solana network
NEXT_PUBLIC_COVENANT_SOLANA_CLUSTER=devnet            # devnet | localnet | mainnet
NEXT_PUBLIC_COVENANT_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_COVENANT_SOLANA_WS_URL=wss://api.devnet.solana.com
COVENANT_PROTOCOL_PROGRAM_ID=CovntSettLement1111111111111111111111111111
COVENANT_SOLANA_CONFIRMATIONS=32
NEXT_PUBLIC_COVNT_MINT=

# Brand / site
NEXT_PUBLIC_SITE_URL=https://opencovenant.org
NEXT_PUBLIC_DOCS_URL=https://docs.opencovenant.org
NEXT_PUBLIC_ANALYTICS_URL=https://analytics.opencovenant.org
NEXT_PUBLIC_COVENANT_X_HANDLE=@opencovenant

# Token
NEXT_PUBLIC_COVENANT_TOKEN_NAME=Covenant Token
NEXT_PUBLIC_COVENANT_TOKEN_SYMBOL=COVNT
NEXT_PUBLIC_COVENANT_TOKEN_DECIMALS=6

# Local daemon HTTP gateway (covenant-web dev only)
NEXT_PUBLIC_COVENANT_HTTP=http://127.0.0.1:8421

# Indexer
INDEXER_BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Backing services (docker compose up -d)
DATABASE_URL=postgres://covenant:covenant@localhost:5432/covenant
REDIS_URL=redis://localhost:6379

# Optional service credentials (off-repo)
# IONET_API_KEY=
# AKASH_WALLET=
# HERMES_API_BASE_URL=
# HERMES_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# SESSION_SECRET=                       # 32+ chars, hex/base64 preferred
