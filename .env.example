# Solana network
NEXT_PUBLIC_COVENANT_SOLANA_CLUSTER=devnet            # devnet | localnet | mainnet
NEXT_PUBLIC_COVENANT_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_COVENANT_SOLANA_WS_URL=wss://api.devnet.solana.com
COVENANT_PROTOCOL_PROGRAM_ID=cov9UDypG7nsryxdgMcKhKU2spRVWLVjxT2iTv6do5Y
COVENANT_SOLANA_CONFIRMATIONS=32
NEXT_PUBLIC_COVNT_MINT=4uTpj4kb8r1NbMGbTwNKoDPvrPpevGNZN2hP4FWUW58E

# Brand / site
NEXT_PUBLIC_SITE_URL=https://opencovenant.org
NEXT_PUBLIC_DOCS_URL=https://docs.opencovenant.org
NEXT_PUBLIC_ANALYTICS_URL=https://analytics.opencovenant.org
NEXT_PUBLIC_COVENANT_X_HANDLE=@opencovenant

# Token
NEXT_PUBLIC_COVENANT_TOKEN_NAME=Covenant Token
NEXT_PUBLIC_COVENANT_TOKEN_SYMBOL=CVNT
NEXT_PUBLIC_COVENANT_TOKEN_DECIMALS=6

# Local daemon HTTP gateway — server-side only. covenant-web proxies all
# daemon traffic through /api/covenant/* so the operator bearer token
# never enters the browser bundle. COVENANT_OPERATOR_TOKEN is a literal
# fallback; the default behaviour reads the daemon-written token at
# ${COVENANT_HOME}/peers/operator.token so rotations propagate without
# a Next.js restart.
COVENANT_DAEMON_URL=http://127.0.0.1:8421
# COVENANT_HOME=$HOME/.covenant
# COVENANT_OPERATOR_TOKEN_PATH=$HOME/.covenant/peers/operator.token
# COVENANT_OPERATOR_TOKEN=

# Indexer
INDEXER_BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# Backing services (docker compose up -d)
DATABASE_URL=postgres://covenant:covenant@localhost:5432/covenant
REDIS_URL=redis://localhost:6379

# Optional service credentials (off-repo)
# IONET_API_KEY=
# AKASH_WALLET=
# HERMES_API_BASE_URL=
# HERMES_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_ALLOWED_USER_IDS=               # comma-separated numeric user ids; empty = deny-all
# TELEGRAM_RATE_LIMIT_PER_MIN=5            # per-user command bucket
# SESSION_SECRET=                       # 32+ chars, hex/base64 preferred
# OPERATOR_BEARER_TOKEN=                # compute-broker; >=16 chars; required for /leases/* side-effect endpoints
# BOND_CANCEL_MAX_EXPIRY_SECS=300       # compute-broker /bonds/cancel signed-request expiry cap
# PROOFGEN_WITNESS_WRAP_KEY=            # proof-gen; 32-byte base64; required, wraps witness AES key outside Redis
# PROOFGEN_RATE_LIMIT_BURST=10
# PROOFGEN_RATE_LIMIT_WINDOW_MS=60000

# Metaplex profile (opt-in). Reads (metaplex.das.*) need only DAS_URL;
# writes (metaplex.attest.*, metaplex.identity.*) need the signer sidecar
# + RPC. Defaults are read-only and devnet. The minting key is read by
# the sidecar from COVENANT_METAPLEX_KEYPAIR and never enters the daemon.
# COVENANT_METAPLEX_ENABLED=false
# COVENANT_METAPLEX_CLUSTER=devnet                 # devnet | mainnet-beta
# COVENANT_METAPLEX_DAS_URL=                        # DAS JSON-RPC endpoint (Helius/Triton/QuickNode free tier); enables reads
# COVENANT_METAPLEX_RPC_URL=                        # Solana RPC the signer submits to; required for writes
# COVENANT_METAPLEX_SIGNER_BIN=                     # absolute path to covenant-metaplex-signer; required for writes
# COVENANT_METAPLEX_KEYPAIR=                        # minting keypair JSON path; read by the sidecar only
# COVENANT_METAPLEX_COLLECTION=                     # MPL Core collection attestations are grouped under
# COVENANT_METAPLEX_PER_ACTION_CAP_LAMPORTS=0       # refuse a write whose rent+fee exceeds this; 0 defers to the sidecar
# COVENANT_METAPLEX_ALLOW=                          # comma-separated tool-slug allowlist (das.get_asset,attest.audit_root); empty = all
