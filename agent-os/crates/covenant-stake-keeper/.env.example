# Required
COVENANT_STAKE_KEEPER_RPC_URL=https://api.mainnet-beta.solana.com
COVENANT_STAKE_KEEPER_CREATOR_KEYPAIR=$HOME/.config/solana/covenant-creator-wallet.json
COVENANT_STAKE_KEEPER_TREASURY_RECIPIENT=<treasury pubkey>
COVENANT_STAKE_KEEPER_SUBSIDY_RECIPIENT=<subsidy pubkey>

# Optional split overrides (must sum to 10000)
# COVENANT_STAKE_KEEPER_STAKERS_BPS=2500
# COVENANT_STAKE_KEEPER_BUYLOCK_BPS=2500
# COVENANT_STAKE_KEEPER_TREASURY_BPS=3000
# COVENANT_STAKE_KEEPER_SUBSIDY_BPS=2000

# Optional cadence overrides
# COVENANT_STAKE_KEEPER_SWEEP_INTERVAL_SECS=3600
# COVENANT_STAKE_KEEPER_ACCRUAL_INTERVAL_SECS=21600

# Safety knobs
COVENANT_STAKE_KEEPER_MIN_SWEEP_LAMPORTS=10000000
COVENANT_STAKE_KEEPER_RESERVE_LAMPORTS=50000000

# Set to "1" for the first 24 hours after deploy. Logs intended splits
# without firing any tx. Flip to "0" only after observing one full sweep
# cycle with the expected split values.
COVENANT_STAKE_KEEPER_DRY_RUN=1

RUST_LOG=covenant_stake_keeper=info
