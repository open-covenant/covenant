  "metadata": {
    "name": "covenant_oracle_program",
    "version": "0.1.0",
    "spec": "0.1.0",
    "description": "Covenant Oracle — gates an MPL Core agent asset's lifecycle (transfer) on a live Covenant audit/policy check via the Core Oracle external plugin."
  },
  "instructions": [
    {
      "name": "init_oracle",
      "docs": [
        "Create the oracle account for `subject` (the agent's Core asset).",
        "The signer becomes the authority allowed to flip the verdict.",
        "Defaults to valid (transfer passes)."
      ],
      "discriminator": [
        78,
        100,
        33,
        183,
        96,
        207,
        60,
        91
      ],
      "accounts": [
        {
          "name": "oracle",
          "writable": true,
          "pda": {
            "seeds": [
              {
                "kind": "const",
                "value": [
                  111,
                  114,
                  97,
                  99,
                  108,
                  101
                ]
              },
              {
                "kind": "arg",
                "path": "subject"
              }
            ]
          }
        },
        {
          "name": "authority",
          "writable": true,
          "signer": true
        },
        {
          "name": "system_program",
          "address": "11111111111111111111111111111111"
        }
      ],
      "args": [
        {
          "name": "subject",
          "type": "pubkey"
        }
      ]
    },
    {
      "name": "set_validation",
      "docs": [
        "Push the live audit/policy verdict. `valid = false` sets `transfer`",
        "to `Rejected`, which makes MPL Core veto any transfer of the gated",
        "asset until it flips back. Authority-only."
      ],
      "discriminator": [
        118,
        163,
        250,
        216,
        185,
        169,
        217,
        214
      ],
      "accounts": [
        {
          "name": "oracle",
          "writable": true
        },
        {
          "name": "authority",
          "signer": true,
          "relations": [
            "oracle"
          ]
        }
      ],
      "args": [
        {
          "name": "valid",
          "type": "bool"
        }
      ]
    }
  ],
  "accounts": [
