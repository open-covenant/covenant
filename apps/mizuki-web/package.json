{
  "name": "@mizuki/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3012",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "PORT=${PORT:-3012} HOSTNAME=${MIZUKI_WEB_HOST:-0.0.0.0} node .next/standalone/apps/mizuki-web/server.js",
    "smoke": "node scripts/smoke-start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@reown/appkit": "1.8.20",
    "@reown/appkit-adapter-solana": "1.8.20",
    "@solana/kit": "5.1.0",
    "@wallet-standard/app": "1.1.0",
    "@wallet-standard/base": "1.1.0",
    "@wallet-standard/features": "1.1.0",
    "@solana/wallet-standard-features": "1.3.0",
    "@x402/fetch": "2.23.0",
    "@x402/svm": "2.23.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
