# One durable, single-replica gateway. All payment/provider bridges bind loopback.
FROM rust:1.98.1-slim-bookworm@sha256:ff521445a372125ed4f76e1453a1f8098f2d05332d1601d30db1c1f62757e730 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates git && rm -rf /var/lib/apt/lists/*
WORKDIR /src/agent-os
COPY agent-os/ ./
ARG COVENANT_BUILD_REVISION
ENV COVENANT_BUILD_REVISION=${COVENANT_BUILD_REVISION}
RUN cargo build --locked --release --bin covenant-compute-gateway --bin covenant-compute-node

FROM node:24.20.0-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/covenant
COPY services/compute-x402-facilitator/package*.json ./services/compute-x402-facilitator/
RUN npm ci --omit=dev --ignore-scripts --prefix services/compute-x402-facilitator && npm cache clean --force
COPY services/compute-x402-facilitator/*.mjs ./services/compute-x402-facilitator/
COPY services/compute-inference-provider/*.mjs ./services/compute-inference-provider/
COPY --from=builder /src/agent-os/target/release/covenant-compute-gateway /usr/local/bin/
COPY --from=builder /src/agent-os/target/release/covenant-compute-node /usr/local/bin/
COPY deploy/compute-x402/ ./deploy/compute-x402/
COPY deploy/compute-canary-watchdog.mjs ./deploy/compute-canary-watchdog.mjs
RUN mkdir -p /data && chown node:node /data && chmod 700 /data
ENV COVENANT_X402_DATA=/data
EXPOSE 10000
ENTRYPOINT ["sh", "/opt/covenant/deploy/compute-x402/entrypoint.sh"]
