# Private credentials are supplied by the deployment secret store.
# Never commit a filled-in copy. One replica; persistent disk mounted at /data.
COVENANT_X402_DATA=/data
COVENANT_X402_OPERATOR_ENABLED=false
COVENANT_GATEWAY_ENABLED=true
COVENANT_GATEWAY_ADMISSIONS_ENABLED=false
# Separate opt-in for bounded sequential batches. Keep false until an immutable
# image and a paid two-child acceptance have passed; use the same value for the
# gateway and private verifier. Existing batch recovery survives disabling it.
COVENANT_GATEWAY_BATCH_ENABLED=false
COVENANT_COMPUTE_COORDINATOR_URL=https://compute-api.opencovenant.org
COVENANT_COMPUTE_COORDINATOR_PUBKEY=3Z27s9cCPNWYg7y86PhGwHpEMV4crrY5vAwTwzQNbjjh
COVENANT_GATEWAY_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
COVENANT_GATEWAY_ASSET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
COVENANT_GATEWAY_SOLANA_RPC=https://api.mainnet-beta.solana.com
COVENANT_GATEWAY_RESOURCE_URL=https://compute-inference.opencovenant.org/v1/chat/completions
# Exact provider-qualified model; enable public admissions only after paid end-to-end acceptance.
COVENANT_GATEWAY_MODEL=claude-haiku-4.5
COVENANT_GATEWAY_PRICE_MICRO_USDC=50000
COVENANT_GATEWAY_OFFER_MICRO_USDC=30000
COVENANT_GATEWAY_RESERVE_MICRO_USDC=3000000
COVENANT_COMPUTE_DAILY_BUDGET_MICRO_USDC=3000000
COVENANT_GATEWAY_MAX_TOKENS=2048
COVENANT_GATEWAY_MAX_INPUT_BYTES=4096
# Optional JSON array of {retail,native} versioned tariff pairs. Set only after
# current model/rates are qualified and coordinator tariff matching is deployed.
# The supervisor materializes immutable files for gateway and operator together.
# Updated clients opt in with pricing:"model_tariff_v1"; omitted pricing retains
# the original flat retail/native prices above and two-block legacy receipts.
# COVENANT_GATEWAY_TARIFFS_JSON
COVENANT_COMPUTE_NODE_EXECUTOR=openai-compat
COVENANT_COMPUTE_NODE_MODELS=claude-haiku-4.5
COVENANT_COMPUTE_OPENAI_DEFAULT_MODEL=claude-haiku-4.5
COVENANT_COMPUTE_NODE_JOB_KINDS=inference_call
COVENANT_COMPUTE_NODE_PRICE_UNIT=per_job
COVENANT_COMPUTE_NODE_PRICE_MICRO_USDC=30000
COVENANT_COMPUTE_NODE_MAX_IN_FLIGHT=1
COVENANT_INFERENCE_PROVIDER_ENABLED=true
COVENANT_INFERENCE_PROVIDER_MODEL=claude-haiku-4.5
COVENANT_INFERENCE_PROVIDER_LIFETIME_BUDGET_MICRO_USDC=1000000
COVENANT_INFERENCE_PROVIDER_DAILY_BUDGET_MICRO_USDC=1000000
COVENANT_INFERENCE_PROVIDER_MAX_PRICE_INPUT_MICRO_USDC_PER_M=1500000
COVENANT_INFERENCE_PROVIDER_MAX_PRICE_OUTPUT_MICRO_USDC_PER_M=7500000
COVENANT_INFERENCE_PROVIDER_MAX_INPUT_BYTES=4096
COVENANT_INFERENCE_PROVIDER_MAX_INPUT_TOKENS=200000
COVENANT_INFERENCE_PROVIDER_MAX_OUTPUT_TOKENS=2048
COVENANT_INFERENCE_PROVIDER_UPSTREAM_TIMEOUT_MS=40000
# Required secret store entries (no example values):
# COVENANT_GATEWAY_IDENTITY_B64: base64 of the dedicated buyer's raw32-byte seed.
# COVENANT_COMPUTE_NODE_IDENTITY_B64: base64 of the operator's raw32-byte seed.
# COVENANT_GATEWAY_FEE_PAYER_KEY_B64: base64 of JSON64-byte Solana keypair.
# COVENANT_GATEWAY_SOLANA_FACILITATOR_URL: optional HTTPS x402 facilitator holding the same fee payer key; it broadcasts Solana payments.
# COVENANT_GATEWAY_BRIDGE_SECRET: persistent random32-byte secret encoded hex.
# COVENANT_INFERENCE_PROVIDER_BEARER_TOKEN: random32-byte secret encoded hex.
# USEPOD_TOKEN: authorized provider credential.
# Required public identity entries, derived from the actual private keys:
# COVENANT_GATEWAY_PAY_TO
# COVENANT_GATEWAY_FEE_PAYER
# COVENANT_COMPUTE_PAYOUT_ADDRESS

COVENANT_GATEWAY_APPROVED_OPERATOR_PUBKEYS=9fefASd52qfR2Q8P81yXtkHu9E4q9KvW58x2ixBAAvLR

# Optional: accept USDC on Base alongside Solana, at the same prices. Leave
# COVENANT_GATEWAY_BASE_PAY_TO unset to offer Solana only. The RPC, facilitator
# URL and Coinbase credentials are passed to the verifier only.
# COVENANT_GATEWAY_BASE_PAY_TO=0xYourBaseAddress
# COVENANT_GATEWAY_BASE_NETWORK=eip155:8453
# COVENANT_GATEWAY_BASE_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# An HTTPS endpoint from your own provider that answers eth_getLogs over 200
# blocks and eth_getTransactionReceipt.
# COVENANT_GATEWAY_BASE_RPC=https://your-base-rpc.example
# Then either CDP_API_KEY_ID and CDP_API_KEY_SECRET (Coinbase Developer Platform
# credentials for Coinbase's facilitator; keep them in your secret store), or
# COVENANT_GATEWAY_BASE_FACILITATOR_URL for another x402 facilitator.

# Optional external observer of the separate coordinator rental-check feed.
# Uses this service's existing disk; no rental/provider/payment permissions.
COVENANT_CANARY_WATCHDOG_ENABLED=false
# Required only when enabled; provision using the deployment secret store:
# COVENANT_CANARY_ALERT_CLOUDFLARE_API_TOKEN
# COVENANT_CANARY_ALERT_CLOUDFLARE_ACCOUNT_ID
# COVENANT_CANARY_ALERT_FROM
# COVENANT_CANARY_ALERT_TO: verified destination pinned to the approved alert route.
