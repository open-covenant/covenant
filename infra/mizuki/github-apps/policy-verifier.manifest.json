{
  "name": "Mizuki Policy Verifier",
  "url": "https://mizuki.opencovenant.org",
  "description": "Read-only independent verification of public issue and merge evidence.",
  "public": true,
  "request_oauth_on_install": false,
  "default_permissions": {
    "checks": "read",
