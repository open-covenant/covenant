{
  "name": "Mizuki Updater",
  "url": "https://mizuki.covenant.org",
  "description": "Protected-branch upgrade pull requests, required-check verification, and merge.",
  "public": false,
  "request_oauth_on_install": false,
  "default_permissions": {
    "actions": "read",
    "checks": "read",
    "contents": "write",
    "metadata": "read",
    "pull_requests": "write"
  },
  "default_events": []
}
