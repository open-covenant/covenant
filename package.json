{
  "name": "covenant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Open, agent-native operating layer for autonomous software systems.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-covenant/covenant.git"
  },
  "homepage": "https://opencovenant.org",
  "bugs": {
    "url": "https://github.com/open-covenant/covenant/issues"
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "agent-os:validate": "bash agent-os/scripts/validate.sh",
    "agent-os:provenance": "node agent-os/scripts/provenance.mjs",
    "readme:validate": "node agent-os/scripts/validate-readme-copy.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp",
      "bufferutil",
      "utf-8-validate"
    ],
    "overrides": {
      "@tanstack/react-query": "5.62.0",
      "underscore": "1.13.8"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "16.2.4",
    "prettier": "3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "turbo": "2.9.8",
    "typescript": "6.0.3"
  }
}
