{
  "name": "covenant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Open, agent-native operating layer for autonomous software systems.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-covenant/covenant.git"
  },
  "homepage": "https://opencovenant.org",
  "bugs": {
    "url": "https://github.com/open-covenant/covenant/issues"
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "agent-os:validate": "bash agent-os/scripts/validate.sh",
    "agent-os:provenance": "node agent-os/scripts/provenance.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "sharp",
      "bufferutil",
      "utf-8-validate"
    ],
    "overrides": {
      "@babel/core": "7.29.6",
      "@hono/node-server": "1.19.15",
      "@solana/spl-token": "0.4.15",
      "@tanstack/react-query": "5.62.0",
      "axios": "1.18.0",
      "brace-expansion": "5.0.9",
      "fast-uri": "3.1.4",
      "find-my-way": "9.7.0",
      "form-data": "4.0.6",
      "hono": "4.12.18",
      "ip-address": "10.1.1",
      "jayson>uuid": "11.1.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "qs": "6.15.2",
      "sharp": "0.35.3",
      "shell-quote": "1.9.0",
      "tar": "7.5.21",
      "underscore": "1.13.8",
      "undici": "7.29.0",
      "ws@7.5.10": "7.5.11",
      "ws@8.18.0": "8.21.0",
      "ws@8.20.1": "8.21.0"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/node": "25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-next": "16.2.4",
    "prettier": "3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "turbo": "2.9.8",
    "typescript": "6.0.3"
  }
}
