{
  "schema": "covenant.sdk-instructions.v1",
  "package": "@covenant-org/sdk",
  "stability": "workspace_alpha",
  "instructions": [
    {
      "name": "register_agent",
      "accounts": ["config", "agent", "operator", "system_program"],
      "data_keys": ["agent_key", "capability_hash", "metadata_hash"]
    },
    {
      "name": "stake",
      "accounts": [
        "config",
        "agent",
        "position",
        "owner",
        "owner_covnt",
        "stake_vault",
        "covnt_mint",
        "token_program",
        "system_program"
      ],
      "data_keys": ["amount_covnt", "lock_until", "token_symbol"]
    },
    {
      "name": "buy_credits",
      "accounts": ["config", "credits", "owner", "owner_covnt", "treasury", "covnt_mint", "token_program"],
      "data_keys": ["amount_covnt"]
    },
    {
      "name": "create_task",
      "accounts": [
        "config",
        "agent",
        "task",
        "client",
        "client_covnt",
        "escrow_vault",
        "covnt_mint",
        "token_program",
        "system_program"
      ],
      "data_keys": ["amount_covnt", "criteria_hash", "deadline", "provider", "task_hash", "task_id"]
    },
    {
      "name": "release_task",
      "accounts": ["config", "task", "client", "escrow_vault", "provider_covnt", "covnt_mint", "token_program"],
      "data_keys": ["receipt_hash", "result_hash"]
    },
    {
      "name": "anchor_receipt_batch",
      "accounts": ["config", "batch", "authority", "system_program"],
      "data_keys": ["batch_id", "merkle_root", "receipt_count"]
    },
    {
      "name": "initialize_compute_payments",
      "accounts": ["config", "compute_config", "authority", "usdc_mint", "system_program"],
      "data_keys": ["settlement_authority"]
    },
    {
      "name": "update_compute_settlement_authority",
      "accounts": ["config", "compute_config", "authority"],
      "data_keys": ["settlement_authority"]
    },
    {
      "name": "fund_compute_job",
      "accounts": [
        "config",
        "compute_config",
        "escrow",
        "client",
        "client_usdc",
        "provider_usdc",
        "escrow_vault",
        "usdc_mint",
        "token_program",
        "system_program"
      ],
      "data_keys": ["expires_at", "job_id", "max_usdc_amount", "provider", "quote_commitment"]
    },
    {
      "name": "settle_compute_job",
      "accounts": [
        "config",
        "compute_config",
        "escrow",
        "settlement_authority",
        "escrow_vault",
        "provider_usdc",
        "client_usdc",
        "usdc_mint",
        "token_program"
      ],
      "data_keys": ["actual_usdc_amount", "receipt_commitment"]
    },
    {
      "name": "refund_compute_job",
      "accounts": [
        "config",
        "compute_config",
        "escrow",
        "authority",
        "escrow_vault",
        "client_usdc",
        "usdc_mint",
        "token_program"
      ],
      "data_keys": ["refund_commitment"]
    }
  ]
}
