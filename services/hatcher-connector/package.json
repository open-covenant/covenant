{
  "name": "@covenant/hatcher-connector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "demo": "npm run build && node dist/demo/run.js",
    "demo:mesh": "npm run build && node dist/demo/meshDemo.js",
    "mesh": "node dist/demo/meshServerMain.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "lint": "echo skip",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "fastify": "5.8.5",
    "pino": "9.5.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/ws": "^8.18.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.5",
    "ws": "^8.21.0"
  }
}
