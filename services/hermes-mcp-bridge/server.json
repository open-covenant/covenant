{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "org.opencovenant/hermes-agent",
  "title": "Hermes Agent MCP Bridge",
  "description": "Expose generic Hermes agent execution through the Hermes API Server from MCP-compatible clients.",
  "repository": {
    "url": "https://github.com/open-covenant/covenant",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@covenant/hermes-mcp-bridge",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "HERMES_API_BASE_URL",
          "description": "Hermes API Server base URL",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "HERMES_API_KEY",
          "description": "Optional Hermes API bearer token",
          "format": "string",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
