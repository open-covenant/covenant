{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "org.opencovenant/covenant",
  "title": "Covenant MCP Bridge",
  "description": "Discover Covenant agents, prepare Solana-native protocol instruction descriptors, and call a local covenantd daemon from MCP-compatible clients.",
  "repository": {
    "url": "https://github.com/open-covenant/covenant",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@covenant/mcp-bridge",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "COVENANT_SOLANA_CLUSTER",
          "description": "Solana cluster label",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COVENANT_SOLANA_RPC_URL",
          "description": "Solana RPC endpoint URL",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COVENANT_SOLANA_WS_URL",
          "description": "Solana websocket endpoint URL",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COVENANT_PROTOCOL_PROGRAM_ID",
          "description": "Covenant protocol program id",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COVNT_MINT",
          "description": "External COVNT SPL mint address",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COVENANT_HTTP_URL",
          "description": "Covenant daemon HTTP gateway URL",
          "format": "string",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "COVENANT_AUTH_TOKEN",
          "description": "Bearer token for Covenant daemon-backed tools",
          "format": "string",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
