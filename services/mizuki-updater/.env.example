NODE_ENV=production
MIZUKI_UPDATER_HOST=0.0.0.0
MIZUKI_UPDATER_PORT=8793
MIZUKI_UPDATER_SUBMIT_TOKEN=replace-with-a-submission-only-token
MIZUKI_UPDATER_CONTROL_TOKEN=replace-with-a-control-only-token
MIZUKI_UPDATER_READ_TOKEN=replace-with-a-distinct-read-only-token
MIZUKI_UPDATER_DATABASE_URL=postgresql://mizuki_updater:password@postgres:5432/mizuki_updater?sslmode=require
MIZUKI_UPDATER_MEMORY_STORE=false

# JSON map of key ID to Ed25519 SPKI public-key PEM. Keep proposal private keys offline.
MIZUKI_UPDATER_PROPOSAL_KEYS_JSON={"release-key-v1":"-----BEGIN PUBLIC KEY-----\nreplace-with-ed25519-public-key\n-----END PUBLIC KEY-----"}
MIZUKI_UPDATER_BENCHMARK_KEYS_JSON={"benchmark-key-v1":"-----BEGIN PUBLIC KEY-----\nreplace-with-benchmark-ed25519-public-key\n-----END PUBLIC KEY-----"}
MIZUKI_UPDATER_REVIEW_KEYS_JSON={"review-key-v1":"-----BEGIN PUBLIC KEY-----\nreplace-with-review-ed25519-public-key\n-----END PUBLIC KEY-----"}
MIZUKI_UPDATER_ALLOWED_REPOSITORIES=open-covenant/covenant
MIZUKI_UPDATER_ALLOWED_BASE_BRANCHES=main
MIZUKI_UPDATER_HEAD_BRANCH_PREFIX=mizuki/capability/
MIZUKI_UPDATER_MANDATORY_CHECKS=application,escrow,rust,landing
MIZUKI_UPDATER_CHECK_PRODUCERS_JSON={"application":{"checkRunAppId":15368,"workflowId":340541049,"workflowPath":".github/workflows/mizuki.yml","event":"pull_request","headBranch":"manifest","headSha":"candidate","baseBranch":"manifest","baseSha":"signed","definitionRef":"base"},"escrow":{"checkRunAppId":15368,"workflowId":340541049,"workflowPath":".github/workflows/mizuki.yml","event":"pull_request","headBranch":"manifest","headSha":"candidate","baseBranch":"manifest","baseSha":"signed","definitionRef":"base"},"rust":{"checkRunAppId":15368,"workflowId":265742803,"workflowPath":".github/workflows/ci.yml","event":"pull_request","headBranch":"manifest","headSha":"candidate","baseBranch":"manifest","baseSha":"signed","definitionRef":"base"},"landing":{"checkRunAppId":15368,"workflowId":265742803,"workflowPath":".github/workflows/ci.yml","event":"pull_request","headBranch":"manifest","headSha":"candidate","baseBranch":"manifest","baseSha":"signed","definitionRef":"base"}}
MIZUKI_UPDATER_PROPOSAL_MAX_AGE_MS=604800000

MIZUKI_UPDATER_ARTIFACT_ORIGINS=https://artifacts.example.com
MIZUKI_UPDATER_ARTIFACT_TIMEOUT_MS=30000
MIZUKI_UPDATER_ARTIFACT_MAX_BYTES=26214400

MIZUKI_UPDATER_GITHUB_API_URL=https://api.github.com
MIZUKI_UPDATER_GITHUB_APP_ID=123456
MIZUKI_UPDATER_GITHUB_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-github-app-private-key\n-----END PRIVATE KEY-----
MIZUKI_UPDATER_GITHUB_TIMEOUT_MS=20000
MIZUKI_UPDATER_GITHUB_MERGE_METHOD=squash

MIZUKI_UPDATER_DEPLOY_CONTROLLER_HOSTPORT=http://mizuki-deployment-controller:8794
MIZUKI_UPDATER_DEPLOY_HOOK_TOKEN=replace-with-at-least-32-random-characters
MIZUKI_UPDATER_HOOK_TIMEOUT_MS=90000

MIZUKI_UPDATER_CHECK_TIMEOUT_MS=1800000
MIZUKI_UPDATER_HEALTH_TIMEOUT_MS=600000
MIZUKI_UPDATER_PROMOTION_SOAK_MS=120000
MIZUKI_UPDATER_PROMOTION_TIMEOUT_MS=600000
MIZUKI_UPDATER_POLL_INTERVAL_MS=5000
MIZUKI_UPDATER_LEASE_MS=180000
MIZUKI_UPDATER_MAX_ATTEMPTS=5
