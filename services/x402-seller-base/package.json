{
  "name": "covenant-x402-seller-base",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public Covenant Trust x402 seller on Base: agents pay per call in USDC (EIP-3009) to obtain a Covenant-signed ed25519 attestation over a claim. Settles through the Coinbase-hosted x402 facilitator and fails closed.",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@x402/core": "2.17.0",
    "@x402/evm": "2.17.0",
    "@x402/express": "2.17.0",
    "@x402/extensions": "2.17.0",
    "bs58": "^6.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
