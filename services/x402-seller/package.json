{
  "name": "covenant-x402-seller",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public x402 v2 seller for bounded Solana observations and publisher-signed statements. Resource delivery and settlement are separate protocol outcomes.",
  "scripts": {
    "build": "rm -rf dist *.tsbuildinfo && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:claims": "node scripts/validate-claims.mjs",
    "test": "npm run validate:claims && node --import tsx --test src/*.test.ts",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@phala/dcap-qvl-web": "0.2.7",
    "@solana/web3.js": "1.98.4",
    "@x402/core": "2.15.0",
    "@x402/express": "2.15.0",
    "@x402/extensions": "2.15.0",
    "@x402/paywall": "2.15.0",
    "@x402/svm": "2.15.0",
    "@zauthx402/sdk": "^0.1.14",
    "bs58": "^6.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
